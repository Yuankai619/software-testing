diff --git a/src/requests/exceptions.py b/src/requests/exceptions.py
index e1cedf88..1891307a 100644
--- a/src/requests/exceptions.py
+++ b/src/requests/exceptions.py
@@ -41,6 +41,11 @@ class JSONDecodeError(InvalidJSONError, CompatJSONDecodeError):
         CompatJSONDecodeError.__init__(self, *args)
         InvalidJSONError.__init__(self, *self.args, **kwargs)
 
+    def __reduce__(self):
+        # IOError's reducer wins in the MRO, but the JSON decoder needs
+        # the message, document, and position to reconstruct the exception.
+        return CompatJSONDecodeError.__reduce__(self)
+
 
 class HTTPError(RequestException):
     """An HTTP error occurred."""
